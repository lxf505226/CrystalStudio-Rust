/tools/_probe_*.py
*_tmp*
*.orig
*.bak
*.rej

# 环境
.env
.env.*
!.env.example
.DS_Store
Thumbs.db

# 凭据（禁止入库；token 只走环境变量 / Authorization 头）
*token*
*credential*
*secret*
